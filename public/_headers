# Cloudflare static-asset response headers.

# HTML should always be revalidated so users get the latest app shell.
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# Camera access requires a secure context; nothing special needed beyond HTTPS,
# which Cloudflare provides by default.

# Hashed/static assets can be cached aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS change between deploys — always revalidate so users get fresh styles.
/css/*
  Cache-Control: no-cache, must-revalidate

/js/*
  Cache-Control: no-cache, must-revalidate
